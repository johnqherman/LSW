{
  "name": "lsw",
  "displayName": "LSW - Linux Subsystem for Windows Development",
  "description": "Build, run, test, and debug Windows applications from Linux through the lsw CLI.",
  "version": "0.2.0",
  "publisher": "lsw",
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#1e1e2e", "theme": "dark" },
  "license": "Apache-2.0 OR MIT",
  "repository": { "type": "git", "url": "https://github.com/johnqherman/LSW", "directory": "editors/vscode" },
  "homepage": "https://github.com/johnqherman/LSW",
  "bugs": { "url": "https://github.com/johnqherman/LSW/issues" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Debuggers", "Testing", "Other"],
  "keywords": ["windows", "wine", "cross-compile", "mingw", "cmake", "rust", "pe", "dap"],
  "activationEvents": ["workspaceContains:lsw.toml", "onDebug"],
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node16",
    "watch": "npm run build -- --sourcemap --watch",
    "vscode:prepublish": "npm run typecheck && npm run build -- --minify"
  },
  "contributes": {
    "commands": [
      { "command": "lsw.setup", "title": "LSW: Setup (detect project, create environment)" },
      { "command": "lsw.init", "title": "LSW: Init (scaffold a new project here)" },
      { "command": "lsw.build", "title": "LSW: Build" },
      { "command": "lsw.run", "title": "LSW: Run" },
      { "command": "lsw.test", "title": "LSW: Test" },
      { "command": "lsw.doctor", "title": "LSW: Doctor (diagnose host + toolchain)" },
      { "command": "lsw.verify", "title": "LSW: Verify on native Windows" },
      { "command": "lsw.configureIntelliSense", "title": "LSW: Configure C/C++ IntelliSense" }
    ],
    "debuggers": [
      {
        "type": "lsw",
        "label": "LSW (native Windows PE)",
        "languages": ["c", "cpp", "rust"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the Windows PE to debug via lsw dap."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lsw",
            "request": "launch",
            "name": "LSW: Debug PE",
            "program": "${workspaceFolder}/build/${workspaceFolderBasename}.exe"
          }
        ],
        "configurationSnippets": [
          {
            "label": "LSW: Debug Windows PE under Wine",
            "body": {
              "type": "lsw",
              "request": "launch",
              "name": "LSW: Debug PE",
              "program": "^\"\\${workspaceFolder}/build/\\${workspaceFolderBasename}.exe\""
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "lsw",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "description": "The lsw subcommand to run (build, test, check, package)."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "lsw-gcc",
        "owner": "lsw",
        "source": "lsw",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|fatal error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "configuration": {
      "title": "LSW",
      "properties": {
        "lsw.path": {
          "type": "string",
          "default": "lsw",
          "description": "Path to the lsw executable."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
